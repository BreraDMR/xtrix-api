# Database Configuration
# ВАЖНО: Замените на свои реальные данные!
DATABASE_URL=postgresql://postgres:***REMOVED***@localhost:5432/medic

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret Key
# ВАЖНО: Сгенерируйте свой уникальный ключ! Минимум 32 символа
# Команда для генерации: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this

# JWT Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Время жизни access token в минутах (по умолчанию 24 часа)
REFRESH_TOKEN_EXPIRE_DAYS=30
# Время жизни refresh token в днях (по умолчанию 30 дней)

# AWS S3 Configuration (опционально, для загрузки файлов)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=

# Stripe Configuration (опционально, для платежей)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple IAP Configuration (опционально, для мобильных платежей)
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_TOKEN=

# Google Play Billing Configuration (опционально, для мобильных платежей)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WEBHOOK_TOKEN=

# SMTP Email Configuration (опционально, для email уведомлений)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio SMS Configuration (опционально, для SMS уведомлений)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Environment
ENVIRONMENT=development
# Для продакшена: ENVIRONMENT=production

# CORS Origins (опционально, через запятую)
# Пример: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=1000/hour
RATE_LIMIT_LOGIN=5/minute

# Logging Configuration
LOG_LEVEL=INFO
# Уровни: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_ERRORS_FILE=logs/errors.log

# Security Headers Configuration
# Content-Security-Policy (опционально, по умолчанию используется базовый)
# Пример: CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline';"
CSP_POLICY=
ENABLE_HSTS=true

# Account Lockout Configuration
MAX_LOGIN_ATTEMPTS=5
# Максимальное количество неудачных попыток входа перед блокировкой
LOCKOUT_DURATION_MINUTES=30
# Длительность блокировки аккаунта в минутах

# Development Settings
DETAILED_ERRORS=true
# Включить детальные сообщения об ошибках для разработки
# В production рекомендуется установить false для безопасности

# Frontend URL (for QR code links)
FRONTEND_URL=http://localhost:3000
# URL фронтенд приложения для генерации ссылок в QR-кодах

