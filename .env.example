DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medic
JWT_SECRET=put-a-random-string-of-at-least-32-chars-here
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
DETAILED_ERRORS=true
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DOCS_USERNAME=
DOCS_PASSWORD=

# --- AI assistant -------------------------------------------------------------
# Which backend the assistant uses: pool (OpenAI-compatible slots below), anthropic, or cli.
LLM_PROVIDER=pool
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4000
# rest for a slot after a 429 without Retry-After; daily quotas rest until 00:00 UTC
LLM_COOLDOWN_SECONDS=60
# used when the user hasn't set a time zone in their preferences
AI_DEFAULT_TIMEZONE=Europe/Prague
# assistant requests per month by subscription plan code (built-in defaults cover the current plans);
# unknown plan -> AI_MONTHLY_LIMIT_DEFAULT, no live subscription -> 0
AI_MONTHLY_LIMIT_DEFAULT=100
AI_MONTHLY_LIMITS=

# Key pool: slots are tried in order, a rate-limited slot rests and the next one answers.
# A slot with an empty LLM_n_API_KEY is skipped. An endpoint that needs no key: LLM_n_API_KEY=none.
# One account per provider - free limits are usually per account/organization, not per key, and
# several accounts on one provider break their terms (OpenRouter says so explicitly).
# FREE TIERS MAY LOG OR TRAIN ON PROMPTS: test data only, never real clients of a salon.
# Optional per slot: LLM_n_MODEL_SMART (role "smart"), LLM_n_NAME (label in usage rows),
# LLM_n_JSON_MODE=json_object|json_schema|none, LLM_n_PRICE_IN / LLM_n_PRICE_OUT (USD per 1M tokens),
# LLM_n_KIND=anthropic for an Anthropic key inside the pool,
# LLM_n_DATA_COLLECTION=allow|deny (OpenRouter only, default allow; deny skips providers that keep prompts).
# Base URLs and model ids checked on the providers' public pages on 2026-10-18; free models change often.

# 1. OpenRouter - free models end with ":free"; 50 requests/day per account (1000 after buying 10 credits).
#    Set LLM_1_DATA_COLLECTION=deny to exclude providers that retain prompts.
LLM_1_BASE_URL=https://openrouter.ai/api/v1
LLM_1_API_KEY=
LLM_1_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# 2. Google AI Studio - free tier; Google uses free-tier prompts to improve its products.
LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_2_API_KEY=
LLM_2_MODEL=gemini-3.8-flash
# 3. Groq - per-organization limits (gpt-oss-120b: 30 rpm, 1000 requests/day on the published table).
LLM_3_BASE_URL=https://api.groq.com/openai/v1
LLM_3_API_KEY=
LLM_3_MODEL=openai/gpt-oss-120b
# 4. Cerebras - no renewing free tier: $5 trial credits for 30 days, card required.
#    gpt-oss-120b is the model there that accepts a system message.
LLM_4_BASE_URL=https://api.cerebras.ai/v1
LLM_4_API_KEY=
LLM_4_MODEL=gpt-oss-120b
# 5. Mistral - free "Experiment" plan per third-party pages, not confirmed on Mistral's own docs.
LLM_5_BASE_URL=https://api.mistral.ai/v1
LLM_5_API_KEY=
LLM_5_MODEL=mistral-small-latest
# 6. Cohere - free trial key, 1000 calls/month, 20 chat requests/min. JSON mode via the compat API unverified.
LLM_6_BASE_URL=https://api.cohere.ai/compatibility/v1
LLM_6_API_KEY=
LLM_6_MODEL=command-a-plus-05-2026
# 7. NVIDIA (build.nvidia.com) - free developer access is not stated on the API page, check your account.
LLM_7_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_7_API_KEY=
LLM_7_MODEL=meta/llama-3.3-70b-instruct
# 8. Cloudflare Workers AI - 10,000 neurons/day free, resets 00:00 UTC. Put your account id in the URL.
LLM_8_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
LLM_8_API_KEY=
LLM_8_MODEL=@cf/openai/gpt-oss-20b
# 9. Z.ai - GLM-4.7-Flash is listed as free on the pricing page; the exact API id is not confirmed there.
LLM_9_BASE_URL=https://api.z.ai/api/paas/v4
LLM_9_API_KEY=
LLM_9_MODEL=glm-4.7-flash
# 10. OVHcloud AI Endpoints - anonymous use allowed at 2 requests/min per IP and model (set the key to none);
#     the base URL comes from third-party guides, OVH's own page doesn't print it.
LLM_10_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
LLM_10_API_KEY=
LLM_10_MODEL=gpt-oss-120b
# Local Ollama, no key, nothing leaves the machine:
# LLM_11_BASE_URL=http://localhost:11434/v1
# LLM_11_API_KEY=none
# LLM_11_MODEL=qwen3:14b

# LLM_PROVIDER=anthropic: Anthropic Messages API directly; the fallback model is tried after the main one.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_MODEL_FALLBACK=
ANTHROPIC_PRICE_IN=0.10
ANTHROPIC_PRICE_OUT=0.50

# LLM_PROVIDER=cli: a logged-in coding CLI on this machine. Local development only - refuses to start
# when ENVIRONMENT=production.
LLM_CLI_COMMAND=claude --print
LLM_CLI_MODEL=

# LLM_PROVIDER=fake: no model at all - every plan request answers with the JSON in LLM_FAKE_PLAN_FILE
# (read on each request, checked like a real model's answer). For web E2E runs and demos; refuses to
# start when ENVIRONMENT=production.
LLM_FAKE_PLAN_FILE=

# --- Voice: speech to text for the assistant ---------------------------------
# pool = the STT_n_* slots below, fake = always returns STT_FAKE_TEXT (not in production).
STT_PROVIDER=pool
STT_FAKE_TEXT=
STT_TIMEOUT_SECONDS=60
# Up to three OpenAI-compatible slots, POST {base}/audio/transcriptions. Same rules as the LLM slots:
# empty key = skipped, "none" = a local server without a key, a rate-limited slot rests.
# Optional: STT_n_NAME (label in usage rows). Checked on the providers' docs pages on 2026-10-18.
# 1. Groq - whisper-large-v3-turbo (also whisper-large-v3); 25 MB per file on the free tier.
#    The free plan's request limits weren't visible on the public rate-limits page (Developer plan: 20 rpm).
STT_1_BASE_URL=https://api.groq.com/openai/v1
STT_1_API_KEY=
STT_1_MODEL=whisper-large-v3-turbo
# 2. OpenAI - gpt-transcribe is the model their guide recommends now (whisper-1, gpt-4o-mini-transcribe
#    still work). Paid, no free tier. Their docs list mp3/mp4/mpeg/m4a/wav/webm - ogg isn't listed.
STT_2_BASE_URL=https://api.openai.com/v1
STT_2_API_KEY=
STT_2_MODEL=gpt-transcribe
# 3. Local speaches (faster-whisper), nothing leaves the machine. Its default port is 8000, which the API
#    takes, so publish it elsewhere: docker run -p 8001:8000 ghcr.io/speaches-ai/speaches:latest-cpu
#    then `uvx speaches-cli model download Systran/faster-whisper-small` and set the key to none.
STT_3_BASE_URL=http://localhost:8001/v1
STT_3_API_KEY=
STT_3_MODEL=Systran/faster-whisper-small

# Invite-only pilot: verified Google signup, seven trial days, then three read-only days.
# This also disables checkout, service payments, and all external notifications.
PILOT_MODE_ENABLED=false
PILOT_INVITED_EMAILS=
