# Copy to /opt/xtrix/.env, chmod 600. Real values live only on the server and in Damir's mac config.
POSTGRES_USER=xtrix
POSTGRES_DB=xtrix
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://xtrix:<POSTGRES_PASSWORD>@db:5432/xtrix
JWT_SECRET=
ENVIRONMENT=production
TRUST_PROXY=true
REDIS_URL=redis://localhost:1/0
FRONTEND_URL=https://xtrix-crm.vercel.app
CORS_ORIGINS=https://xtrix-crm.vercel.app
GOOGLE_CLIENT_ID=
PILOT_MODE_ENABLED=true
PILOT_OPEN_SIGNUP=true
DETAILED_ERRORS=false
DOCS_USERNAME=
DOCS_PASSWORD=
# test keys only on this copy, webhooks still point at Render
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# AI pool, same keys as on Render (LLM_1_* .. LLM_9_*, STT_*)
LLM_PROVIDER=pool
STT_PROVIDER=pool

# nothing goes out to real people from this copy
NOTIFICATION_TRANSPORT=capture
PUSH_NOTIFICATIONS_ENABLED=false
VISITOR_AUTH_MAIL_MODE=disabled
SMTP_HOST=
SMTP_FROM=
TWILIO_SID=
TWILIO_TOKEN=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
GMAIL_DELIVERY_ENABLED=false
PILOT_EMAIL_DELIVERY_ENABLED=false
JOBS_CHANNEL=email

NGROK_AUTHTOKEN=
